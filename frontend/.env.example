# URL of your deployed Google Apps Script Web App, e.g.
# https://script.google.com/macros/s/AKfycb.../exec
# Leave blank to run in demo mode with seeded fake data.
VITE_API_URL=

# The VAPID PUBLIC key Code.gs's setup() logs on first run (Apps Script editor -> Executions
# or View -> Logs). Needed for the Settings screen's push-notification reminders to work.
# Leave blank to hide the reminders feature.
VITE_VAPID_PUBLIC_KEY=
